# ==========================================
# Nemotron Code Sentinel — Environment Config
# ==========================================
# Copy this file to .env and fill in your API key:
#   cp .env.example .env
#
# Get a free NVIDIA API key (no credit card):
#   https://build.nvidia.com → Sign in → Generate Key

# NVIDIA NIM (Free developer tier)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR_KEY_HERE
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Alternative: Nebius Token Factory (Hackathon production)
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# LLM_API_KEY=YOUR_NEBIUS_KEY_HERE
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
